SPADE_SERVER=localhost
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_SUMMARIZATION_MODEL=mistral
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=512
OLLAMA_FALLBACK_TO_EXTRACT=true

# Source for RSS feeds, assigned to one instance of a Crawler agent
# Collected from: https://github.com/plenaryapp/awesome-rss-feeds?tab=readme-ov-file
RSS_FEEDS_PATH=src/sp1/data/rss.example.jsonc

# Blackboard JSON persistence path (relative to repo root)
BLACKBOARD_PATH=data/blackboard.json
